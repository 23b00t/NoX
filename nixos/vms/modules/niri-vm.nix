# A VM's own niri desktop on a passed-through GPU (godot-gpu): the same base
# config as dom0 (desktop/niri-base.nix: input, layout, look, the keys for
# windows, columns, workspaces and monitors, generic window rules), plus a
# few launch keys. No waybar, rofi, swaylock, notifications or display
# manager: greetd logs the user straight into niri.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.services.niri-vm;
  kdl = import ../../lib/kdl.nix { inherit lib; };
  theme = import ../../desktop/theme.nix {
    inherit lib;
    name = cfg.theme;
  };
  base = import ../../desktop/niri-base.nix {
    inherit lib theme;
    inherit (cfg) keyboard;
  };

  settings = base.settings // {
    binds =
      base.binds
      // {
        "Mod+Shift+Slash"."show-hotkey-overlay" = { };
        "Mod+Q" = {
          _props.repeat = false;
          "close-window" = { };
        };
      }
      // lib.mapAttrs (_: command: { spawn = command; }) cfg.launch;
    _children = map (command: { "spawn-at-startup"._args = command; }) cfg.startup ++ base.windowRules;
  };

  niriConfig = pkgs.writeTextFile {
    name = "niri-config.kdl";
    text = ''
      // Generated by NoX (vms/modules/niri-vm.nix)
      ${lib.removeSuffix "\n" (
        kdl.toKDL {
          escapeBackslashes = true;
          escapeTabs = true;
        } settings
      )}
    '';
    checkPhase = ''
      ${lib.getExe config.programs.niri.package} validate --config "$target"
    '';
  };
in
{
  options.services.niri-vm = {
    enable = lib.mkEnableOption "the VM's own niri desktop (dom0's base config)";

    user = lib.mkOption {
      type = lib.types.str;
      default = "user";
      description = "User greetd logs into niri.";
    };

    theme = lib.mkOption {
      type = lib.types.str;
      default = "tokyo-night";
      description = "Desktop theme (NoX desktop/themes/<name>.nix), as nox.desktop.theme in dom0.";
    };

    keyboard =
      lib.mapAttrs
        (
          name: default:
          lib.mkOption {
            type = lib.types.str;
            inherit default;
            description = "xkb ${name} (empty: not set), as nox.desktop.keyboard in dom0.";
          }
        )
        {
          layout = "us";
          variant = "";
          options = "";
        };

    launch = lib.mkOption {
      type = lib.types.attrsOf (lib.types.listOf lib.types.str);
      default = { };
      example = {
        "Mod+T" = [ "foot" ];
        "Mod+B" = [ "firefox" ];
      };
      description = "Keys that start a program (niri key → command).";
    };

    startup = lib.mkOption {
      type = lib.types.listOf (lib.types.listOf lib.types.str);
      default = [ ];
      example = [ [ "godot" ] ];
      description = "Programs started with the session.";
    };
  };

  config = lib.mkIf cfg.enable {
    programs.niri.enable = true;
    environment.etc."niri/config.kdl".source = niriConfig;

    services.greetd = {
      enable = true;
      settings = rec {
        initial_session = {
          command = "niri-session";
          inherit (cfg) user;
        };
        default_session = initial_session;
      };
    };
  };
}
