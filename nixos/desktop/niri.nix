{
  pkgs,
  lib,
  config,
  inputs,
  vmRegistry,
  ...
}:
let
  theme = import ./theme.nix {
    inherit lib;
    inherit (config.nox.desktop) theme;
  };
  # Shared with VMs that run their own niri (godot-gpu): input, layout, look,
  # window and workspace keys, generic window rules
  base = import ./niri-base.nix {
    inherit lib theme;
    inherit (config.nox.desktop) keyboard;
  };
  login = import ./login-on-host.nix { inherit vmRegistry; } config.nox.desktop.login;
  kdl = import ../lib/kdl.nix { inherit lib; };
  # The merged settings; a bind set to null (`"Mod+Q" = null`) is removed
  settings =
    let
      s = config.nox.desktop.niri.settings;
    in
    s // { binds = lib.filterAttrs (_: bind: bind != null) (s.binds or { }); };
  niriConfig = pkgs.writeTextFile {
    name = "niri-config.kdl";
    text = ''
      // Generated by NoX from `nox.desktop.niri.settings`
      ${lib.removeSuffix "\n" (
        kdl.toKDL {
          escapeBackslashes = true;
          escapeTabs = true;
        } settings
      )}
    '';
    checkPhase = ''
      ${lib.getExe config.programs.niri.package} validate --config "$target"
    '';
  };
  # One window rule per trust label (nox.desktop.labels); windows matching
  # none keep the layout default `unknown`
  labelRules = map (l: {
    "window-rule"._children = [
      { match._props."app-id" = l.appId; }
      {
        border = {
          "active-color" = l.active;
          "inactive-color" = l.inactiveBorder;
        };
      }
      {
        "focus-ring" = {
          "active-color" = l.active;
          "inactive-color" = l.inactiveRing;
        };
      }
    ];
  }) config.nox.desktop.labels;

  trayApps = import ./tray-apps.nix { inherit lib vmRegistry; };
  trayCommands = lib.concatLists (
    lib.mapAttrsToList (
      vm:
      map (
        app:
        [
          "nox"
          "run"
          vm
        ]
        ++ app
      )
    ) trayApps
  );

  # Terminals at login (nox.desktop.login.terminalTabs): dom0's foot and a
  # zellij terminal per VM over wprs, as tabs of one column. All start at
  # once; niri's event stream reports each window as it opens (VMs may still
  # boot), it goes into the column right away, at its place in the order of
  # terminalTabs; after 5 min the rest is given up.
  #
  # Windows are identified by the launch, never by an app id the app chose
  # (zellij's is fixed): dom0's foot by its pid; a VM's terminal is the next
  # new window whose app id is "[<vm>]" or starts with "[<vm>] " (the prefix
  # dom0's wprsc sets, one wprsc per VM, a VM cannot fake it). Dedup is the
  # VM's: the terminal starts with a fixed token (NOX_APP_TOKEN, nox run
  # prints the VM's answer "ok: already started" when it lives already, then
  # no window is awaited). Launches into one VM are not concurrent (one
  # terminal per VM). The placed windows are recorded per niri instance, so
  # a second run (vm-autostart after a VM's restart) knows the column.

  # terminal-tabs [tab…] (default: all of nox.desktop.login.terminalTabs)
  terminalTabs = pkgs.writeShellScript "terminal-tabs" ''
    set -u
    jq=${pkgs.jq}/bin/jq
    [ $# -gt 0 ] || set -- ${lib.escapeShellArgs login.terminalTabs}
    order=(${lib.escapeShellArgs login.terminalTabs})
    declare -A rank id_of expect seen rec token
    for i in "''${!order[@]}"; do rank[''${order[$i]}]=$i; done
    ${lib.concatMapStrings (t: "token[${t}]=${login.termToken t}\n") (
      lib.filter (t: t != "dom0") login.terminalTabs
    )}
    col=() # tabs of the column, in tab order
    dom0_pid=""
    ws=${lib.escapeShellArg (toString login.terminalWorkspace)}
    # Window ids are stable for niri's lifetime: the placed windows are
    # kept per niri instance (its socket name holds niri's pid), so a second
    # run takes those that are still open as the column
    state="''${XDG_RUNTIME_DIR:-/tmp}/terminal-tabs.$(basename "''${NIRI_SOCKET:-none}")"
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    if [ -r "$state" ]; then
      while read -r rid rtab; do rec[$rid]=$rtab; done <"$state"
    fi
    save_col() {
      for t in "''${col[@]}"; do echo "''${id_of[$t]} $t"; done >"$state"
    }

    # Runs the command with the window focused (column actions act on the
    # focused column), the focus goes back afterwards
    as_focused() {
      local id=$1 prev
      shift
      prev=$(niri msg --json focused-window | $jq -r '.id // empty')
      niri msg action focus-window --id "$id"
      "$@"
      [ -z "$prev" ] || [ "$prev" = "$id" ] || niri msg action focus-window --id "$prev"
    }
    style_column() {
      niri msg action set-column-display tabbed
      niri msg action set-column-width 100%
    }
    move_up() {
      for _ in $(seq "$1"); do niri msg action move-window-up; done
    }

    # A new terminal: to the terminal workspace, into the column on its
    # left (the first one makes the column: tabbed, full width), then up
    # past the tabs that come after it in the order
    place() {
      local id=$1 tab=$2 k=0 a n
      id_of[$tab]=$id
      [ -z "$ws" ] || niri msg action move-window-to-workspace --window-id "$id" --focus false "$ws"
      if [ ''${#col[@]} -eq 0 ]; then
        as_focused "$id" style_column
        col=("$tab")
        save_col
        return
      fi
      niri msg action consume-or-expel-window-left --id "$id"
      for a in "''${col[@]}"; do
        [ "''${rank[$a]}" -le "''${rank[$tab]}" ] || k=$((k + 1))
      done
      [ "$k" -eq 0 ] || as_focused "$id" move_up "$k"
      n=$((''${#col[@]} - k))
      col=("''${col[@]:0:n}" "$tab" "''${col[@]:n}")
      save_col
    }

    # The VM's answer to a terminal start (written by start_vm)
    check_answers() {
      local t answer
      for t in "''${!expect[@]}"; do
        [ -s "$dir/$t" ] || continue
        answer=$(cat "$dir/$t")
        rm -f "$dir/$t"
        case "$answer" in
          "ok: started"*) ;; # its window follows
          *) # lives already, or the start failed: no window to wait for
            unset "expect[$t]"
            pending=$((pending - 1))
            ;;
        esac
      done
    }

    # "init <id> <pid> <app id>" per open window (column order), "ready",
    # then "open <id> <pid> <app id>" per new or changed window
    coproc events {
      timeout 300 niri msg --json event-stream | $jq --unbuffered -r '
        if .WindowsChanged then
          (.WindowsChanged.windows
            | sort_by(.layout.pos_in_scrolling_layout[1] // 0)
            | .[] | "init \(.id) \(.pid // 0) \(.app_id // "")"), "ready"
        elif .WindowOpenedOrChanged then
          .WindowOpenedOrChanged.window | "open \(.id) \(.pid // 0) \(.app_id // "")"
        else empty end'
    }
    prefix_re='^\[([^]]+)\]( |$)'
    started=0 pending=0
    while :; do
      rc=0
      read -r -t 1 kind id pid app <&"''${events[0]}" || rc=$?
      [ "$started" -eq 0 ] || check_answers
      # All there
      if [ "$started" -eq 1 ] && [ "$pending" -le 0 ]; then break; fi
      [ "$rc" -le 128 ] || continue # no event within 1 s
      [ "$rc" -eq 0 ] || break # stream ended: time limit
      case "$kind" in
        init)
          [ "$started" -eq 0 ] || continue
          seen[$id]=1
          # Placed by an earlier run and still open: they are the column
          tab=''${rec[$id]:-}
          [ -n "$tab" ] && [ -n "''${rank[$tab]+x}" ] && [ -z "''${id_of[$tab]+x}" ] || continue
          id_of[$tab]=$id
          col+=("$tab")
          ;;
        ready)
          [ "$started" -eq 0 ] || continue
          started=1
          [ "''${#col[@]}" -eq 0 ] || save_col
          for t in "$@"; do
            [ -n "''${rank[$t]+x}" ] && [ -z "''${id_of[$t]+x}" ] || continue
            expect[$t]=1
            pending=$((pending + 1))
            if [ "$t" = dom0 ]; then
              foot ${lib.escapeShellArgs login.dom0Command} &
              dom0_pid=$!
            else
              (
                out=$(NOX_APP_TOKEN="''${token[$t]}" nox run "$t" ${lib.escapeShellArgs login.vmTerminal})
                printf '%s\n' "$out" >"$dir/$t.tmp"
                mv "$dir/$t.tmp" "$dir/$t"
              ) &
            fi
          done
          [ "$pending" -gt 0 ] || break
          ;;
        open)
          # Every window counts once, the first event is its opening
          [ -z "''${seen[$id]+x}" ] || continue
          seen[$id]=1
          [ "$started" -eq 1 ] || continue
          tab=""
          if [ -n "$dom0_pid" ] && [ "$pid" = "$dom0_pid" ] && [ -n "''${expect[dom0]+x}" ]; then
            tab=dom0
          elif [[ "$app" =~ $prefix_re ]] && [ -n "''${expect[''${BASH_REMATCH[1]}]+x}" ]; then
            tab=''${BASH_REMATCH[1]}
          fi
          [ -n "$tab" ] || continue
          unset "expect[$tab]"
          place "$id" "$tab"
          [ "$tab" != dom0 ] || niri msg action focus-window --id "$id"
          pending=$((pending - 1))
          ;;
      esac
    done
    kill "''${events_PID:-}" 2>/dev/null
    # End of the login layout, for nox-timing (nox.dev.timing)
    ${lib.optionalString config.nox.dev.timing.enable ''
      ${pkgs.util-linux}/bin/logger -t nox-timing "tabs: done, $pending missing"
    ''}
    exit 0
  '';

  binds = base.binds // {
    # Replaces niri's built-in hotkey overlay (Mod+Shift+Slash)
    "Mod+Slash" = {
      _props."hotkey-overlay-title" = "Keybinding Viewer";
      "spawn-sh" = "pkill rofi || niri-binds";
    };

    "Mod+T" = {
      _props."hotkey-overlay-title" = "Open a Terminal: foot";
      spawn = [ "foot" ];
    };

    "Mod+A" = {
      _props."hotkey-overlay-title" = "Run an Application: rofi";
      "spawn-sh" =
        "pkill rofi || rofi -modi drun,filebrowser,window,run -show drun -theme /etc/xdg/rofi/config.rasi";
    };

    "Mod+Alt+L" = {
      _props."hotkey-overlay-title" = "Lock the Screen: swaylock";
      spawn = [
        "swaylock"
        "-C"
        "/etc/xdg/swaylock/config"
      ];
    };

    "Mod+Comma" = {
      _props."hotkey-overlay-title" = "Emoji Picker";
      "spawn-sh" =
        "rofimoji --max-recent 10 --action print --selector-args='-theme /etc/xdg/rofi/config.rasi' | vm-clip put";
    };

    "Mod+Alt+C" = {
      _props."hotkey-overlay-title" = "Copy Clipboard to the dom0 Store";
      spawn = [
        "vm-clip"
        "copy"
      ];
    };

    "Mod+Alt+V" = {
      _props."hotkey-overlay-title" = "Paste the dom0 Store into the Focused Window";
      spawn = [
        "vm-clip"
        "paste"
      ];
    };

    "Mod+E" = {
      _props."hotkey-overlay-title" = "Open Explorer";
      spawn = [ "explorer" ];
    };

    "Mod+P" = {
      _props."hotkey-overlay-title" = "Region Screenshot";
      screenshot = { };
    };

    "Mod+Shift+P" = {
      _props."hotkey-overlay-title" = "Fullscreen Screenshot";
      "screenshot-screen" = { };
    };

    "Mod+R" = {
      _props."hotkey-overlay-title" = "Region Recording";
      spawn = [ "screenrec-region" ];
    };

    "Mod+Shift+R" = {
      _props."hotkey-overlay-title" = "Fullscreen Recording";
      spawn = [ "screenrec-full" ];
    };

    "XF86AudioRaiseVolume" = {
      _props = {
        "hotkey-overlay-title" = "Volume Up";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+";
    };

    "XF86AudioLowerVolume" = {
      _props = {
        "hotkey-overlay-title" = "Volume Down";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-";
    };

    "XF86AudioMute" = {
      _props = {
        "hotkey-overlay-title" = "Mute Audio";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
    };

    "XF86AudioMicMute" = {
      _props = {
        "hotkey-overlay-title" = "Mute Microphone";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";
    };

    "XF86MonBrightnessUp" = {
      _props = {
        "hotkey-overlay-title" = "Brightness Up";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "brightnessctl -e4 -n2 set 5%+";
    };

    "XF86MonBrightnessDown" = {
      _props = {
        "hotkey-overlay-title" = "Brightness Down";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "brightnessctl -e4 -n2 set 5%-";
    };

    # The same without Fn: Mod+PgUp/PgDn/Backspace volume, with Shift brightness
    "Mod+Page_Up" = {
      _props = {
        "hotkey-overlay-title" = "Volume Up";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+";
    };

    "Mod+Page_Down" = {
      _props = {
        "hotkey-overlay-title" = "Volume Down";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-";
    };

    "Mod+BackSpace" = {
      _props = {
        "hotkey-overlay-title" = "Mute Audio";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
    };

    "Mod+Shift+Page_Up" = {
      _props = {
        "hotkey-overlay-title" = "Brightness Up";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "brightnessctl -e4 -n2 set 5%+";
    };

    "Mod+Shift+Page_Down" = {
      _props = {
        "hotkey-overlay-title" = "Brightness Down";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "brightnessctl -e4 -n2 set 5%-";
    };

    "XF86AudioPlay" = {
      _props = {
        "hotkey-overlay-title" = "Play/Pause";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "playerctl play-pause";
    };

    "XF86AudioPause" = {
      _props = {
        "hotkey-overlay-title" = "Play/Pause";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "playerctl play-pause";
    };

    "XF86AudioPrev" = {
      _props = {
        "hotkey-overlay-title" = "Previous Track";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "playerctl previous";
    };

    "XF86AudioNext" = {
      _props = {
        "hotkey-overlay-title" = "Next Track";
        "allow-when-locked" = true;
      };
      "spawn-sh" = "playerctl next";
    };

    "Mod+Q" = {
      _props.repeat = false;
      _props."hotkey-overlay-title" = "Close Window (press twice)";
      spawn = [ "close-guard" ];
    };

    "Mod+Period" = {
      _props."hotkey-overlay-title" = "Glyph Picker (Nerd Font)";
      "spawn-sh" =
        "rofimoji --files nerd_font --max-recent 10 --action print --selector-args='-theme /etc/xdg/rofi/config.rasi' | vm-clip put";
    };

    Print.screenshot = { };
    "Ctrl+Print"."screenshot-screen" = { };
    "Alt+Print"."screenshot-window" = { };

  };

  # One viewer entry per action; keys sharing an action are merged
  bindEntries =
    let
      describe =
        name: arg:
        let
          words = lib.splitString "-" name;
          human = lib.concatStringsSep " " (
            [ (lib.toUpper (lib.substring 0 1 (lib.head words)) + lib.substring 1 (-1) (lib.head words)) ]
            ++ lib.tail words
          );
        in
        if arg == "" then human else "${human} ${arg}";
      entry =
        key: bind:
        let
          action = lib.head (lib.attrNames (removeAttrs bind [ "_props" ]));
          value = bind.${action};
          args =
            if lib.isList value then
              value
            else if lib.isAttrs value then
              [ ]
            else
              [ (toString value) ];
          title = bind._props."hotkey-overlay-title" or (describe action (lib.concatStringsSep " " args));
        in
        {
          inherit title;
          key = lib.replaceStrings [ "Mod+" ] [ "Super+" ] key;
          command =
            "niri msg action ${action}" + lib.optionalString (args != [ ]) " -- ${lib.escapeShellArgs args}";
        };
      # The merged binds: NoX's and the user's (nox.desktop.niri.settings)
      grouped = lib.groupBy (e: e.command) (lib.mapAttrsToList entry settings.binds);
    in
    lib.sortOn (e: lib.toLower e.line) (
      lib.mapAttrsToList (command: es: {
        inherit command;
        line = "${(lib.head es).title}   ${lib.concatMapStringsSep " / " (e: e.key) es}";
      }) grouped
    );
in
{
  config = lib.mkIf (config.nox.desktop.compositor == "niri") {
    programs.niri.enable = true;
    environment.etc."niri/config.kdl".source = niriConfig;

    # programs.niri adds the gnome portal (screencasting) and gnome-keyring
    # (Secret portal). niri's niri-portals.conf, plus the GTK file chooser:
    # the gnome one needs nautilus, which dom0 does not have (niri docs,
    # Important Software)
    xdg.portal.config.niri = {
      default = [
        "gnome"
        "gtk"
      ];
      "org.freedesktop.impl.portal.Access" = [ "gtk" ];
      "org.freedesktop.impl.portal.Notification" = [ "gtk" ];
      "org.freedesktop.impl.portal.Secret" = [ "gnome-keyring" ];
      "org.freedesktop.impl.portal.FileChooser" = [ "gtk" ];
    };

    environment.systemPackages = with pkgs; [
      # niri starts Xwayland with it on demand
      xwayland-satellite

      # Keybinding viewer: every bind of the merged niri config, searchable in rofi;
      # Enter runs the bind's action through niri
      (writeShellScriptBin "niri-binds" ''
        cmds=(${lib.escapeShellArgs (map (e: e.command) bindEntries)})
        i=$(rofi -dmenu -i -no-custom -p " " -format i \
          -theme /etc/xdg/rofi/config.rasi \
          -theme-str 'window { width: 60em; } listview { lines: 14; }' \
          < ${
            pkgs.writeText "niri-binds.txt" (lib.concatMapStrings (e: e.line + "\n") bindEntries)
          }) || exit 0
        eval "''${cmds[$i]}"
      '')
    ];

    nox = {
      desktop = {
        # niri's answers to the compositor hooks (nox-wm, desktop/session.nix)
        wm = {
          focusedWindow = ''
            niri msg --json focused-window |
              ${pkgs.jq}/bin/jq -r 'select(. != null) | "\(.id)\t\(.pid // "")\t\(.app_id // "")"'
          '';
          windows = ''
            niri msg --json windows | ${pkgs.jq}/bin/jq -r '.[].app_id // empty'
          '';
          closeWindow = ''
            niri msg action close-window --id "$1"
          '';
          focusedOutput = ''
            niri msg --json focused-output | ${pkgs.jq}/bin/jq -r '.name // empty'
          '';
          openTerminals = ''
            exec ${terminalTabs} "$@"
          '';
          # What dom0 may show a VM (dom0/screencast.nix): outputs, then the
          # windows with their app id (VM windows: "[<vm>] …") and title
          castTargets = ''
            niri msg --json outputs |
              ${pkgs.jq}/bin/jq -r 'to_entries[] | select(.value.logical != null) | "output\t\(.key)\tScreen \(.key)"'
            niri msg --json windows |
              ${pkgs.jq}/bin/jq -r '.[] | "window\t\(.id)\t\((.app_id // "?") + "  " + (.title // "") | gsub("[\\t\\n\\r]"; " "))"'
          '';
          # niri offers org.gnome.Mutter.ScreenCast (for xdg-desktop-portal-gnome)
          cast = ''
            exec ${
              inputs.nox.packages.${pkgs.stdenv.hostPlatform.system}.nox-screencast
            }/bin/nox-mutter-cast "$@"
          '';
        };

        niri.settings = base.settings // {
          "screenshot-path" = "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png";

          # Defaults per bind: the user rebinds with the same key, or removes
          # one with `"Mod+Q" = null`
          binds = lib.mapAttrs (_: lib.mkDefault) binds;

          _children = [
            {
              "spawn-at-startup"._args = [
                "systemctl"
                "--user"
                "restart"
                "wpaperd.service"
              ];
            }
            # VM apps at session start: wprsd kept Super as pressed (apps got
            # every key as Super+key); the wprs modifier sync (NoX's wprs fork,
            # modules/wprs-overlay.nix) releases it. The login windows
            # (nox.desktop.login) and the tray apps (`trayApps` above) are
            # appended after this list.
          ]
          ++ base.windowRules
          # The user's login windows (nox.desktop.login): terminalTabs puts the
          # terminals into one tabbed full-width column itself (no window rule)
          ++ lib.optionals (login.terminalTabs != [ ]) [
            { "spawn-at-startup"._args = [ "${terminalTabs}" ]; }
          ]
          ++ map (w: {
            "spawn-at-startup"._args = [
              "env"
              "NOX_APP_TOKEN=${w.token}"
              "nox"
              "run"
              w.vm
            ]
            ++ w.command;
          }) login.windows
          ++ map (args: { "spawn-at-startup"._args = args; }) trayCommands
          ++ labelRules;
        };

      };
    };
  };
}
